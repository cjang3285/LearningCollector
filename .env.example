# LearningCollector 환경 변수 템플릿
# 이 파일을 .env로 복사하여 실제 값을 입력하세요
# cp .env.example .env

# ========================================
# GitHub 설정
# ========================================
# GitHub Personal Access Token
# 생성: https://github.com/settings/tokens
# 권한: repo (전체)
GITHUB_TOKEN=ghp_your_token_here

# GitHub Username (레포지토리 소유자)
# API 요청의 주체가 되며, Baekjoon 레포지토리 소유자 username을 입력합니다.
GITHUB_USERNAME=your_github_username

# GitHub 커밋 수집 대상 (작성자 이름 기준)
# 여기에 지정된 이름으로 작성된 커밋을 수집합니다. (쉼표로 구분)
# 예: JANG CHANWOOK,Claude
GITHUB_COMMIT_AUTHORS=Your Profile Name

# GitHub 수집 활성화 (true/false)
COLLECT_GITHUB=true

# ========================================
# 백준 설정 (선택)
# ========================================
# 백준 핸들 (아이디)
BAEKJOON_HANDLE=your_baekjoon_handle

# 백준허브 연동 레포 이름 (기본값: Baekjoon_solutions)
BAEKJOON_REPO=Baekjoon_solutions

# 백준 수집 활성화 (true/false)
COLLECT_BAEKJOON=true

# ========================================
# PostgreSQL 설정
# ========================================
# 블로그와 같은 DB 사용, learning 스키마로 분리
DB_HOST=localhost
DB_PORT=5432
DB_NAME=my_blog
DB_USER=postgres
DB_PASSWORD=your_password

# ========================================
# 파일 경로 설정 (선택, 기본값 사용 권장)
# ========================================
# AI 채팅 다운로드 폴더 (Claude, ChatGPT, Gemini 마크다운 파일 위치)
# 기본값: ~/Downloads
# 예시: /home/jcw/shared (Z 드라이브 등)
AI_CHAT_DOWNLOAD_DIR=/home/jcw/shared

# 아티팩트 저장 폴더
# ARTIFACT_DIR=./learning_artifacts

# 로그 폴더
# LOG_DIR=./logs

# ========================================
# 데몬 설정 (systemd service)
# ========================================
# 감시 폴더 (기본값: /home/jcw/shared)
# LEARNING_WATCH_DIR=/home/jcw/shared

# Hot Reload (코드 변경 시 자동 재시작, 기본값: true)
# 개발 중: true (편리함), 운영 중: false (안정성)
HOT_RELOAD=true
