# Module 1: 인증 정보
GITHUB_TOKEN=ghp_your_token_here
# 초안 생성은 Claude Pro(claude CLI)로 처리하기 위한 장기 토큰
# 발급: claude setup-token (실제 터미널에서 실행, 브라우저 인증 필요)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-your_long_lived_token_here

# Module 2: 감시
AI_CHAT_DOWNLOAD_DIR=/path/to/downloads
LOG_FILE_PATH=./log/err.log

# Module 3: 필터링 및 환경 설정
GITHUB_USERNAME=your_username
EDITOR_COMMAND=code
