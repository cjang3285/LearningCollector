[Unit]
Description=LearningETL Client Agent
Documentation=https://github.com/cjang3285/LearningETL
After=network.target

[Service]
Type=simple

# 사용자 설정 (본인의 사용자명으로 변경)
User=username
Group=username

# 작업 디렉토리 (본인의 경로로 변경)
WorkingDirectory=/home/username/LearningETL

# 가상환경 경로 설정
Environment="PATH=/home/username/LearningETL/venv/bin"

# Client Agent 실행 (서버 URL 변경 필수)
ExecStart=/home/username/LearningETL/venv/bin/python client/agent.py --server http://raspberrypi.local:8000

# 재시작 설정
Restart=always
RestartSec=10

# 로그 설정
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
