[Unit]
Description=LearningETL Daemon - AI Chat Auto Collector
After=network.target postgresql.service

[Service]
Type=simple
User={{USER}}
Group={{USER}}
WorkingDirectory={{PROJECT_ROOT}}

# 환경변수 파일
EnvironmentFile={{PROJECT_ROOT}}/.env

# 실행 명령
ExecStart={{PROJECT_ROOT}}/venv/bin/python {{PROJECT_ROOT}}/scripts/runtime/learningetl-daemon.py

# 자동 재시작
Restart=always
RestartSec=10

# 로그 분리 (INFO/WARNING → daemon.log, ERROR → daemon-error.log)
StandardOutput=append:{{PROJECT_ROOT}}/logs/daemon.log
StandardError=append:{{PROJECT_ROOT}}/logs/daemon-error.log

[Install]
WantedBy=multi-user.target
