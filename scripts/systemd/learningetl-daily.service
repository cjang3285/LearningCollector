[Unit]
Description=LearningETL Daily Scan
After=network.target postgresql.service

[Service]
Type=oneshot
User=jcw
Group=jcw
WorkingDirectory=/home/jcw/LearningETL

# 환경변수 파일
EnvironmentFile=/home/jcw/LearningETL/.env

# 실행 명령 (AI 채팅 스캔)
ExecStart=/home/jcw/LearningETL/venv/bin/python /home/jcw/LearningETL/main.py --ai-chat-scan

# 로그
StandardOutput=append:/home/jcw/LearningETL/logs/daily-scan.log
StandardError=append:/home/jcw/LearningETL/logs/daily-scan.log
